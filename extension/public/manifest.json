{
  "manifest_version": 3,
  "name": "fitsyou",
  "version": "0.0.0",
  "description": "See how clothing looks on you before you buy.",
  "permissions": ["activeTab", "storage", "scripting", "sidePanel"],
  "host_permissions": [
    "*://*.zara.com/*",
    "*://*.asos.com/*",
    "*://*.hm.com/*",
    "*://*.zalando.com/*",
    "*://*.zalando.de/*",
    "*://*.zalando.co.uk/*",
    "*://*.mango.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "fitsyou",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": [
        "*://*.zara.com/*",
        "*://*.asos.com/*",
        "*://*.hm.com/*",
        "*://*.zalando.com/*",
        "*://*.zalando.de/*",
        "*://*.zalando.co.uk/*",
        "*://*.mango.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.zara.com/*",
        "*://*.asos.com/*",
        "*://*.hm.com/*",
        "*://*.zalando.com/*",
        "*://*.zalando.de/*",
        "*://*.zalando.co.uk/*",
        "*://*.mango.com/*"
      ],
      "js": ["badge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.zara.com/*",
        "*://*.asos.com/*",
        "*://*.hm.com/*",
        "*://*.zalando.com/*",
        "*://*.zalando.de/*",
        "*://*.zalando.co.uk/*",
        "*://*.mango.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; object-src 'self'"
  },
  "externally_connectable": {
    "matches": [
      "https://fitsyou.live/*",
      "https://fitsyou-web.vercel.app/*",
      "http://localhost:3000/*"
    ]
  }
}
