{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": ["chrome", "node"],
    "paths": { "@/*": ["./extension/src/*"] }
  },
  "include": ["extension/src"]
}
